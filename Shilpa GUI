def ROI_Extraction_1(img_):
    # cprint("====================================", color="yellow")
    # cprint("Extracting ROI.", color="green")
    # cprint("====================================", color="yellow")

    # Remove background
    # if DB == "Food_Calorie":
    img_ = remove(img_)

    # Ensure image has alpha
    if img_.shape[2] != 4:
        print("No alpha channel found")
        return img_, (0, 0, img_.shape[1], img_.shape[0])

    # Alpha channel
    alpha = img_[:, :, 3]

    # Binary mask from alpha
    _, thresh = cv2.threshold(alpha, 1, 255, cv2.THRESH_BINARY)

    # Optional cleanup
    kernel = np.ones((3, 3), np.uint8)
    thresh = cv2.morphologyEx(thresh, cv2.MORPH_OPEN, kernel)

    # Find contours
    contours, _ = cv2.findContours(
        thresh,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    if len(contours) == 0:
        return img_, (0, 0, img_.shape[1], img_.shape[0])

    # Largest contour
    contour = max(contours, key=cv2.contourArea)

    # Bounding rectangle
    x, y, w, h = cv2.boundingRect(contour)

    # Crop ROI
    roi = img_[y:y + h, x:x + w]
    roi = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
    roi1 = cv2.resize(roi, dsize=(224, 224))
    return roi1


