def Preprocessing(img):
    if DB == "Food_Calorie":
        cropped_img = ROI_Extraction(img)
    else:
        cropped_img = ROI_Extraction(img)
    # Handle channel conversion safely
    if len(cropped_img.shape) == 3:

        if cropped_img.shape[2] == 4:
            cropped_img = cv2.cvtColor(
                cropped_img,
                cv2.COLOR_BGRA2BGR
            )

        elif cropped_img.shape[2] == 3:
            cropped_img = cropped_img.copy()

    lab = cv2.cvtColor(cropped_img, cv2.COLOR_BGR2LAB)

    l, a, b = cv2.split(lab)

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    cl = clahe.apply(l)

    limg = cv2.merge((cl, a, b))

    clahe_rgb = cv2.cvtColor(
        limg,
        cv2.COLOR_LAB2BGR
    )

    return clahe_rgb


