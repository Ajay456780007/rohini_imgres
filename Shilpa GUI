def draw_text_without_overlap(image, text, x, y, used_positions):
    """
    Draw text near object without overlapping.
    """

    h, w = image.shape[:2]

    # Candidate positions
    candidate_positions = [
        (x, y - 10),  # top
        (x, y + 25),  # bottom
        (x - 60, y),  # left
        (x + 10, y)  # right
    ]

    for tx, ty in candidate_positions:

        overlap = False

        for px, py in used_positions:

            if abs(tx - px) < 80 and abs(ty - py) < 30:
                overlap = True
                break

        if not overlap:
            tx = max(5, min(tx, w - 120))
            ty = max(20, min(ty, h - 10))

            # Background rectangle
            cv2.rectangle(
                image,
                (tx - 2, ty - 18),
                (tx + 120, ty + 5),
                (0, 0, 0),
                -1
            )

            # Text
            cv2.putText(
                image,
                text,
                (tx, ty),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.35,
                (0, 255, 0),
                1,
                cv2.LINE_AA
            )

            used_positions.append((tx, ty))
            return image

    return image


